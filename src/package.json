{
  "name": "focus-compta",
  "version": "0.87.0",
  "description": "Focus Compta — cockpit financier de pré-comptabilité pour PME et magasins d'optique.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win",
  "dist:win": "electron-builder --win",
  "test:s3": "node scripts/test-s3.js",
  "check:syntax": "node --check database.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check scripts/test-s3.js && node --check src/storage/s3Storage.js"
},
  "dependencies": {
    "@aws-sdk/client-s3": "^3.953.0",
    "@aws-sdk/s3-request-presigner": "^3.953.0",
    "better-sqlite3": "latest",
    "dotenv": "^17.2.3",
    "electron": "latest",
    "pdf-parse": "latest"
  },
  "devDependencies": {
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "fr.thefocuscompany.focuscompta",
    "productName": "Focus Compta",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!FocusComptaData/**",
      "!FocusComptaBackups/**",
      "!node_modules/.cache/**",
      "!dist/**",
      "!build/**",
      "!out/**",
      "!.git/**",
      "!.env"
    ]
  }
}
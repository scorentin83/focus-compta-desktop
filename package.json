{
  "name": "focus-compta",
  "version": "0.86.1",
  "description": "Focus Compta Desktop",
  "main": "src/main.js",
  "author": "Corentin Sauvage",
  "license": "Private",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.2",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5"
  },
  "build": {
    "appId": "fr.thefocuscompany.focuscompta",
    "productName": "Focus Compta",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!FocusComptaData/**",
      "!FocusComptaBackups/**",
      "!node_modules/.cache/**",
      "!dist/**",
      "!build/**",
      "!out/**",
      "!.git/**"
    ]
  }
}